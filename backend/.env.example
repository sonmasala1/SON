NODE_ENV=development
PORT=5000
MONGODB_URI=
MONGODB_DB_NAME=son_masala
# Optional. Leave unset unless the system resolver cannot resolve Atlas SRV records.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
CORS_ORIGINS=http://localhost:3000,https://son-dusky.vercel.app
ENABLE_DEMO_CHECKOUT=false
DELIVERY_CHARGE_PAISE=4900
FREE_DELIVERY_THRESHOLD_PAISE=49900
AUTH_DEV_PREVIEW=false
SESSION_CROSS_SITE_COOKIES=false
# Generate 32 random bytes encoded as base64. Keep the existing production key.
ADMIN_MFA_ENCRYPTION_KEY=
STAFF_APP_ORIGIN=http://localhost:3000
ADMIN_WEBAUTHN_RP_ID=localhost
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SON MASALA
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
# Tests must use a separate replica set and temporary database names.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27018/?replicaSet=sonDemo
